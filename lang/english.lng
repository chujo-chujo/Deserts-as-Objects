##grflangid 0x01

# General GRF strings
STR_GRF_NAME:Deserts as Objects v1.1
STR_GRF_DESCRIPTION:{}{ORANGE}Adds desert tiles from OpenGFX, OpenGFX2 and Toyland2mars as objects (and more).{}{}Also includes options to:{}- replace the current baseset's desert terrain tiles{}- replace cacti with alternative vegetation{}- spawn random objects during map generation{}{}Use {LTBROWN}Set parameters {ORANGE}to choose from available variants.{}{}{}{SILVER}Graphics: {YELLOW}OpenGFX, OpenGFX2, Toyland2mars, OpenGFX+ Landscape, OpenGFX2 Objects (all licensed under GPLv2){}{SILVER}Additions and coding: {YELLOW}chujo{}{}{}{LTBLUE}August 8, 2026
STR_GRF_URL:https://github.com/chujo-chujo/Deserts-as-Objects

#####################################################

# Parameters
STR_PAR_replace_NAME:Desert graphics replacement
STR_PAR_replace_DESC:{GOLD}Select the desert graphics style to replace your current baseset's deserts.
STR_PAR_replace_NONE:None
STR_PAR_replace_OGFX2_grid:OpenGFX2 ({PUSH_COLOUR}{SILVER}gridlines{POP_COLOUR})
STR_PAR_replace_OGFX2_nogrid:OpenGFX2 ({PUSH_COLOUR}{SILVER}no gridlines{POP_COLOUR})
STR_PAR_replace_OGFX_grid:OpenGFX ({PUSH_COLOUR}{SILVER}gridlines{POP_COLOUR})
STR_PAR_replace_OGFX_nogrid:OpenGFX ({PUSH_COLOUR}{SILVER}no gridlines{POP_COLOUR})
STR_PAR_replace_Mars:Mars from Toyland2mars
STR_PAR_replace_OGFX2ARCTIC_grid:OpenGFX2 Arctic ({PUSH_COLOUR}{SILVER}gridlines{POP_COLOUR})
STR_PAR_replace_OGFX2ARCTIC_nogrid:OpenGFX2 Arctic ({PUSH_COLOUR}{SILVER}no gridlines{POP_COLOUR})

STR_OGFX2_objects_grid_NAME:Add OpenGFX2 desert tiles as objects ({PUSH_COLOUR}{SILVER}gridlines{POP_COLOUR})
STR_OGFX2_objects_grid_DESC:{GOLD}
STR_OGFX2_objects_nogrid_NAME:Add OpenGFX2 desert tiles as objects ({PUSH_COLOUR}{SILVER}no gridlines{POP_COLOUR})
STR_OGFX2_objects_nogrid_DESC:{GOLD}

STR_OGFX_objects_grid_NAME:Add OpenGFX desert tiles as objects ({PUSH_COLOUR}{SILVER}gridlines{POP_COLOUR})
STR_OGFX_objects_grid_DESC:{GOLD}
STR_OGFX_objects_nogrid_NAME:Add OpenGFX desert tiles as objects ({PUSH_COLOUR}{SILVER}no gridlines{POP_COLOUR})
STR_OGFX_objects_nogrid_DESC:{GOLD}

STR_MARS_objects_grid_NAME:Add Mars desert tiles as objects ({PUSH_COLOUR}{SILVER}gridlines{POP_COLOUR})
STR_MARS_objects_grid_DESC:{GOLD}

STR_random_oases_NAME:Spawn {PUSH_COLOUR}{DKGREEN}oases {POP_COLOUR}in deserts
STR_random_oases_DESC:{GOLD}Randomly places oases on desert tiles during map generation. The number represents the amount of objects placed on a {WHITE}256×256 {GOLD}tile map (for comparison, there are {WHITE}15 {GOLD}transmitters).{}{}{WHITE}[Range: 0–255, 0=Off]
STR_yellow_rocks_NAME:Spawn {PUSH_COLOUR}{GOLD}yellow rocks {POP_COLOUR}in deserts
STR_gray_rocks_NAME:Spawn {PUSH_COLOUR}{SILVER}gray rocks {POP_COLOUR}in deserts
STR_brown_rocks_NAME:Spawn {PUSH_COLOUR}{CREAM}brown rocks {POP_COLOUR}in deserts
STR_random_rocks_DESC:{GOLD}Randomly places rock patches on desert tiles during map generation. The number represents the amount of objects placed on a {WHITE}256×256 {GOLD}tile map (for comparison, there are {WHITE}15 {GOLD}transmitters).{}{}{WHITE}[Range: 0–255, 0=Off]

STR_replace_cacti_NAME:Replace cacti with alternative vegetation
STR_replace_cacti_DESC:{GOLD}Toggle to replace the default cacti with alternative vegetation (plants, palm trees, or a mix) creating a less North American desert style.
STR_PAR_plants:Plants
STR_PAR_palms:Palms
STR_PAR_mix:Mix

STR_remove_NAME:Remove objects only by demolishing
STR_remove_DESC:{GOLD}If enabled, only the {WHITE}demolish tool {GOLD}can be used to remove an object.
STR_remove_random_NAME:Remove spawned objects only by demolishing
STR_remove_random_DESC:{GOLD}If enabled, only the {WHITE}demolish tool {GOLD}can be used to remove randomly generated objects (oases, rocks).

# Class names
STR_CLASSNAME:Deserts as Objects

# Names of objects
STR_sand:Sand
STR_grass_sand:Grass/sand
STR_rocks:Rocks
STR_autosnow:Snow (snowline-responsive)
STR_snow:Snow
STR_cacti:Cacti
STR_palms:Palm trees
STR_plants:Plants
STR_people:People, cars
STR_oasis:Oasis

# Descriptions of objects
STR_autoslope:{GREEN}Autoslope
STR_autocoast:{GREEN}Autocoast + on water
STR_autoslope_coast:{GREEN}Autoslope, autocoast
STR_rock_autosnow:{GREEN}Snowline-responsive, autoslope
STR_no_autosnow:{GREEN}Permanent snow, autoslope

# Error string
STR_error_plants:Incorrect terrain type.
STR_error_oasis:Oasis can be placed only on flat terrain.